# Etienne Agency BDR Dashboard — Environment Variables

# OpenAI
OPENAI_API_KEY=sk-...

# Apollo.io
APOLLO_API_KEY=

# Instantly.ai
INSTANTLY_API_KEY=

# Google Workspace (Service Account JSON path or inline)
GOOGLE_SERVICE_ACCOUNT_KEY=

# Gmail OAuth (for Jim's inbox monitoring)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Google Maps API
GOOGLE_MAPS_API_KEY=

# Telegram (legacy — from rainey.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DATABASE_URL=file:./data/bdr.db

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
